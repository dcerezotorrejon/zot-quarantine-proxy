# Build desde la raíz del repo:
#   podman build -t localhost/zot-proxy:latest -f proxy/Containerfile .
FROM registry.fedoraproject.org/fedora-minimal:latest

RUN microdnf install -y python3 python3-pip skopeo clamav clamd clamav-data umoci \
 && microdnf clean all \
 && python3 -m venv /opt/venv

COPY proxy/requirements.txt /tmp/requirements.txt
RUN /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt \
 && rm /tmp/requirements.txt

COPY config/containers/registries.conf.d/zqp.conf /etc/containers/registries.conf.d/zqp.conf
COPY config/clamav/clamd.conf /etc/clamd.d/scan.conf
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/srv \
    PYTHONUNBUFFERED=1

WORKDIR /srv
COPY shared/zqp /srv/zqp
COPY proxy/app /srv/app

EXPOSE 5001
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["python", "-m", "app.server"]
